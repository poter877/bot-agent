PORT=5679

# Optional. SQLite 数据库文件位置（默认仓库根 data/huobao.sqlite3）
# SQLITE_PATH=/path/to/huobao.sqlite3

# Optional. 数据根目录（默认仓库根 data/；桌面版由 Electron 注入 HUOBAO_DATA_DIR）
# HUOBAO_DATA_DIR=/path/to/data
# STORAGE_PATH=/path/to/data/static

# Optional. MySQL → SQLite 启动自动迁移（老用户升级）：显式配置 DATABASE_URL 或
# MYSQL_HOST 且 SQLite 为空库时，启动自动一次性导入全部表（原子事务 + 行数校验 +
# 成功后写 .mysql-imported 标记）。关闭：MYSQL_AUTO_IMPORT=false
# DATABASE_URL=mysql://huobao:huobao@127.0.0.1:3306/huobao_drama

# Optional. Public base URL of this backend. Required when passing locally
# uploaded reference videos/audios/files to an upstream video API (local
# /static paths are resolved as PUBLIC_BASE_URL + path).
# PUBLIC_BASE_URL=https://your-domain.com

# Optional. 文本模型单次响应的输出 token 上限（随请求 maxOutputTokens 下发），
# 防止服务商默认上限截断 Agent 的规划文本 + 工具调用。
# AI_MAX_TOKENS=16384

# Optional. MCP 工具服务（POST /mcp，streamable HTTP）的 Bearer 令牌 —— hermes
# agent ↔ ai-drama 后端之间的鉴权，与 bot-backend 无关。不配置时 /mcp 一律 403
# （fail-closed）；配置后调用方需带 Authorization: Bearer <token>。
# AI_DRAMA_MCP_TOKEN=change-me

# Required for all agent execution. 编排（工具循环 + 模型选择）已外移到 hermes gateway：
# 所有 agent 调用走 POST {HERMES_AGENT_URL}/v1/chat/completions（Bearer HERMES_AGENT_KEY），
# ai-drama 领域工具由 hermes 经 MCP（AI_DRAMA_MCP_TOKEN 鉴权）回调本服务执行。
# 未配置时 agent 调用直接报错，不回落本地编排。
# HERMES_AGENT_URL=http://127.0.0.1:8787
# HERMES_AGENT_KEY=change-me
