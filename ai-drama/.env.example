# Docker 部署环境变量（复制为 .env 后修改）
# 默认使用当前源码构建的 React 镜像
VIDEO_FACTORY_IMAGE=video-factory:local

# 可选自动更新：先将 VIDEO_FACTORY_IMAGE 改为自己发布的 React 镜像，
# 配置以下 URL，并使用 docker compose --profile auto-update up -d --build
# HUOBAO_WATCHTOWER_URL=http://watchtower:8080
# Watchtower HTTP API 令牌，启用时两侧必须一致；生产环境务必修改
WATCHTOWER_TOKEN=please-change-me

# 构建镜像时注入的版本号（发布时指定，如 1.2.0；本地构建保持 dev 即可）
HUOBAO_VERSION=dev

# HTTP API 共享令牌（Authorization: Bearer）。容器/服务器部署必配：端口映射下浏览器
# 请求来自非回环地址，未配置时后端只放行回环来源，所有 /api/v1 请求都会 401。
# 生成：openssl rand -hex 24。浏览器首次访问会弹窗要求输入一次（存在 localStorage）。
# /api/v1/health 保持开放（巡检探活）；/mcp 不走此令牌（见 AI_DRAMA_MCP_TOKEN）。
AI_DRAMA_API_TOKEN=change-me

# hermes gateway 调用本服务 /mcp 的令牌（fail-closed：未配置或不符一律 403）。
# 与 AI_DRAMA_API_TOKEN 分开命名，可同值部署。
# AI_DRAMA_MCP_TOKEN=change-me-too

# 公司模型后端（bot-backend）：所有文本/图像/视频/语音/转写与 Fal 队列的唯一出口。
# 厂商密钥只存在公司后端服务端；不配置时迁移不播种 company 配置、公司工具不可用。
# COMPANY_BACKEND_URL=http://bot-backend:8080
# COMPANY_SERVICE_TOKEN=change-me  # must equal bot-backend's INTERNAL_SERVICE_TOKEN

# hermes gateway（编排大脑）：所有 agent 执行（工具循环 + 模型选择）外移到 hermes，
# 经 POST {HERMES_AGENT_URL}/v1/chat/completions 调用（Bearer HERMES_AGENT_KEY）；
# 未配置时 agent 调用直接报错，不回落本地编排。
# HERMES_AGENT_URL=http://host.docker.internal:8787
# HERMES_AGENT_KEY=change-me
