{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "tests/drama/creative-renderer.test.ts",
    "tests/drama/film-blender.test.ts",
    "tests/drama/**/*.mjs",
    "src/drama/**/*.ts"
  ]
}
