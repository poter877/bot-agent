{
  "name": "bot-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ToC unified business backend \u2014 account module. Hono / Node.js / TypeScript / PostgreSQL / Redis.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "cloud-worker:dev": "tsx watch src/cloud-worker/index.ts",
    "cloud-worker:start": "node dist/cloud-worker/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.drama.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:drama": "tsx --test tests/drama/hermes-agent.test.ts tests/drama/creative-renderer.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/fal": "3.0.62",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@ai-sdk/xai": "5.0.23",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "~1.32.1",
    "ai": "7.0.140",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redis": "^6.3.0",
    "sharp": "^0.34.5",
    "three": "^0.183.2",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.11",
    "redis-memory-server": "^0.17.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
