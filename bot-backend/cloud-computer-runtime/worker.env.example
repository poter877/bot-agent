# Dedicated Docker host only. Never put this token in a desktop or runtime container.
CLOUD_WORKER_TOKEN=replace-with-at-least-32-random-characters
CLOUD_WORKER_HOST=127.0.0.1
CLOUD_WORKER_PORT=3031
CLOUD_WORKER_DOCKER=/usr/bin/docker
CLOUD_WORKER_IPTABLES=/usr/sbin/iptables
CLOUD_WORKER_PYTHON=/usr/bin/python3
# Build the supplied image first; pin a registry digest when promoting a deployment.
CLOUD_WORKER_IMAGE=bot-cloud-desktop:local
CLOUD_WORKER_NETWORK=bot-cloud-desktop
CLOUD_WORKER_WIDTH=1440
CLOUD_WORKER_HEIGHT=900
CLOUD_WORKER_CPUS=2
CLOUD_WORKER_MEMORY_MB=2048
CLOUD_WORKER_MAX_RUNNING=10
# Optional after installing and testing a supported sandbox runtime:
# CLOUD_WORKER_RUNTIME=runsc
