# bot-backend configuration. Copy to .env (git-ignored) and fill in.
# Secrets live ONLY here / in the deployment secret store — never in config
# files under version control. Missing critical values abort startup.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=30172
LOG_LEVEL=info

# --- Authoritative stores ----------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:30173/bot_backend
REDIS_URL=redis://127.0.0.1:30174

# --- Better Auth (register / login / session) --------------------------------
# Generate with: openssl rand -base64 48   (minimum 32 chars, no default)
BETTER_AUTH_SECRET=change-me-generate-a-real-secret-at-least-32-chars
# Must match the actual entry clients use (scheme + host [+ port]).
BETTER_AUTH_URL=http://127.0.0.1:30172
# 管理员引导（二选一）：① 系统零管理员时访问 /admin/setup 创建首个管理员（推荐，
# 初始化后该页自动关闭）；② 配置名单邮箱，用该邮箱注册即自动成为 admin。
# 角色持久化在数据库，之后由后台「用户」页管理。
#BOT_BACKEND_ADMIN_EMAILS=ops@company.com
# Extra origins allowed by the library's CSRF/origin checks (comma separated).
# Browser clients must be listed here and in CORS_ALLOWED_ORIGINS.
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Request boundary --------------------------------------------------------
# Exact Origins allowed cross-origin (comma separated, credentials enabled).
# Desktop clients do not need CORS; keep this empty unless a browser joins.
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
API_BODY_LIMIT_BYTES=16384            # 16 KiB
REQUEST_TIMEOUT_MS=10000              # 10 s processing budget
SERVER_GRACEFUL_TIMEOUT_MS=15000

# --- Rate limits (initial values; tune under load on target hardware) --------
RATE_LIMIT_ENTRY_MAX=300
RATE_LIMIT_ENTRY_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_IP_MAX=10
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=900
RATE_LIMIT_USER_MAX=120
RATE_LIMIT_USER_WINDOW_SECONDS=60

# --- Model requests ----------------------------------------------------------
# Catalog aliases are the only model IDs clients may select. Choose upstream
# model versions available to your provider account; native video uses Google.
# Optional catalog fields: displayName, default, contextLength, maxOutputTokens,
# capabilities {tools, vision, video, reasoning}. The authenticated desktop
# receives aliases and capabilities only through GET /api/llm/models.
# tools/vision default true for compatibility; video/reasoning default false.
LLM_MODEL_CATALOG=[]
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# JSON bytes, including base64 expansion (~4/3 of the original file size).
LLM_STREAM_BODY_LIMIT_BYTES=67108864    # 64 MiB, independent of auth body limits

# --- Account cloud computer --------------------------------------------------
# Optional until a dedicated Linux Docker worker has been provisioned.
CLOUD_COMPUTER_ENABLED=false
# Same-host worker defaults to loopback. Remote workers require a private TLS endpoint.
# CLOUD_COMPUTER_WORKER_URL=http://127.0.0.1:3031
# Same secret as CLOUD_WORKER_TOKEN in the worker service, at least 32 characters.
# CLOUD_COMPUTER_WORKER_TOKEN=
CLOUD_COMPUTER_RATE_LIMIT_MAX=600      # per account / minute, includes screen polling
CLOUD_COMPUTER_IP_RATE_LIMIT_MAX=1200  # per source IP / minute; tune for shared NAT


# ── Media generation (image/video, doc 流式服务端重构 §6) ──
# Catalogs: JSON arrays of {id, provider, model, enabled, maxImages?} — clients
# name the catalog id, provider keys stay server-side.
LLM_IMAGE_CATALOG=[{"id":"nano-banana","provider":"fal","model":"fal-ai/nano-banana","enabled":true},{"id":"flux-schnell","provider":"fal","model":"fal-ai/flux/schnell","enabled":true}]
LLM_VIDEO_CATALOG=[{"id":"fal-video","provider":"fal","model":"fal-ai/minimax/hailuo-02/standard/text-to-video","enabled":true}]
FAL_KEY=
XAI_API_KEY=
# Internal service token for ai-drama: Authorization: Bearer <token> on /api/media/*
# Internal service principal shared by server-to-server callers (ai-drama):
# set INTERNAL_SERVICE_TOKEN; MEDIA_SERVICE_TOKEN is the deployed alias for
# the same value (either is accepted, INTERNAL_SERVICE_TOKEN is the name).
INTERNAL_SERVICE_TOKEN=
MEDIA_SERVICE_TOKEN=
MEDIA_SERVICE_USER_ID=company-media
# Managed tool gateway (search): server-held provider keys, clients ride the
# session/service token. Catalog is JSON: [{id, provider: tavily|brave, enabled, priority}]
TOOLS_SEARCH_CATALOG=
TAVILY_API_KEY=
BRAVE_API_KEY=
# Managed tool gateway (extract): same contract with Firecrawl/Jina.
# Catalog is JSON: [{id, provider: firecrawl|jina, enabled, priority}]
TOOLS_EXTRACT_CATALOG=
FIRECRAWL_API_KEY=
JINA_API_KEY=
RATE_LIMIT_TOOLS_MAX=60
RATE_LIMIT_TOOLS_WINDOW_SECONDS=60

# ── 视频工厂子应用（/api/v1、/mcp、/static）──
# 公司模型网关（本服务自身）：drama 的模型/媒体调用出口；不配置则公司能力不可用
COMPANY_BACKEND_URL=http://localhost:30172
COMPANY_SERVICE_TOKEN=            # 与 INTERNAL_SERVICE_TOKEN 同值
# hermes gateway（编排大脑）：不配置则 drama 的 agent 调用报错
HERMES_AGENT_URL=http://127.0.0.1:30175
HERMES_AGENT_KEY=
# hermes 经 streamable HTTP 调用本服务 /mcp 的令牌
AI_DRAMA_MCP_TOKEN=
# 可选：/api/v1 浏览器共享令牌（未配置时凭 Better Auth 会话；服务调用方 Bearer 旁路）
AI_DRAMA_API_TOKEN=
# 可选：媒体/作业数据根与资产锚点（缺省 ai-drama/data、bot-backend/workspace、bot-backend/film-core）
# AI_DRAMA_DATA_ROOT=/path/to/data
# WORKSPACE_PATH=/path/to/workspace
# FILM_CORE_PATH=/path/to/film-core
# FRONTEND_DIST=/path/to/frontend-react/dist

