# bot-backend configuration. Copy to .env (git-ignored) and fill in.
# Secrets live ONLY here / in the deployment secret store — never in config
# files under version control. Missing critical values abort startup.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Authoritative stores ----------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bot_backend
REDIS_URL=redis://127.0.0.1:6379

# --- Better Auth (register / login / session) --------------------------------
# Generate with: openssl rand -base64 48   (minimum 32 chars, no default)
BETTER_AUTH_SECRET=change-me-generate-a-real-secret-at-least-32-chars
# Must match the actual entry clients use (scheme + host [+ port]).
BETTER_AUTH_URL=http://127.0.0.1:3000
# Extra origins allowed by the library's CSRF/origin checks (comma separated).
# Browser clients must be listed here and in CORS_ALLOWED_ORIGINS.
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Request boundary --------------------------------------------------------
# Exact Origins allowed cross-origin (comma separated, credentials enabled).
# Desktop clients do not need CORS; keep this empty unless a browser joins.
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
API_BODY_LIMIT_BYTES=16384            # 16 KiB
REQUEST_TIMEOUT_MS=10000              # 10 s processing budget
SERVER_GRACEFUL_TIMEOUT_MS=15000

# --- Rate limits (initial values; tune under load on target hardware) --------
RATE_LIMIT_ENTRY_MAX=300
RATE_LIMIT_ENTRY_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_IP_MAX=10
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=900
RATE_LIMIT_USER_MAX=120
RATE_LIMIT_USER_WINDOW_SECONDS=60
