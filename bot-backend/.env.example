# bot-backend configuration. Copy to .env (git-ignored) and fill in.
# Secrets live ONLY here / in the deployment secret store — never in config
# files under version control. Missing critical values abort startup.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Authoritative stores ----------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bot_backend
REDIS_URL=redis://127.0.0.1:6379

# --- Tokens ------------------------------------------------------------------
# Generate with: openssl rand -base64 48   (minimum 32 chars, no default)
AUTH_JWT_SECRET=change-me-generate-a-real-secret-at-least-32-chars
JWT_ISSUER=bot-backend
JWT_AUDIENCE=bot-desktop
ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days
VERIFY_TOKEN_TTL_SECONDS=86400        # 24 hours
RESET_TOKEN_TTL_SECONDS=3600          # 1 hour
MAX_TOKEN_VERIFY_ATTEMPTS=5

# --- Request boundary --------------------------------------------------------
# Exact Origins allowed cross-origin (comma separated). Desktop clients use
# Bearer tokens and do not need CORS; keep this empty unless a browser client
# is added. TRUSTED_PROXIES: IPs/CIDRs of the reverse proxy allowed to set
# X-Forwarded-For (comma separated, e.g. 10.0.0.5,127.0.0.1).
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
API_BODY_LIMIT_BYTES=16384            # 16 KiB
REQUEST_TIMEOUT_MS=10000              # 10 s processing budget
SERVER_GRACEFUL_TIMEOUT_MS=15000

# --- Rate limits (initial values; tune under load on target hardware) --------
RATE_LIMIT_ENTRY_MAX=300
RATE_LIMIT_ENTRY_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_IP_MAX=10
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=900
RATE_LIMIT_FORGOT_IP_MAX=10
RATE_LIMIT_FORGOT_IP_WINDOW_SECONDS=3600
RATE_LIMIT_FORGOT_ACCOUNT_MAX=5
RATE_LIMIT_FORGOT_ACCOUNT_WINDOW_SECONDS=3600
RATE_LIMIT_VERIFY_IP_MAX=30
RATE_LIMIT_VERIFY_IP_WINDOW_SECONDS=3600
RATE_LIMIT_USER_MAX=120
RATE_LIMIT_USER_WINDOW_SECONDS=60

# --- Argon2id (OWASP minimum; tune on target hardware) -----------------------
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENCY=4

# --- Mail channel ------------------------------------------------------------
# `log` prints the mail body (with the one-time link) to the local log —
# development only; production refuses to boot with it.
MAIL_TRANSPORT=log
MAIL_FROM=Bot <no-reply@example.com>
APP_BASE_URL=http://127.0.0.1:3000
# When MAIL_TRANSPORT=smtp:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=secret
# SMTP_SECURE=false
MAIL_OUTBOX_POLL_MS=5000
MAIL_OUTBOX_MAX_ATTEMPTS=5
